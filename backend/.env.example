PORT=5000
DATABASE_URL=postgresql://postgres:your_password@db_host:5432/jaibhajarang_inventory
# Optional fallback, only used if DATABASE_URL is not set
DB_HOST=db_host
DB_PORT=5432
DB_NAME=jaibhajarang_inventory
DB_USER=postgres
DB_PASS=your_password
DB_SSL=true
SHOP_ID=1
NODE_ENV=production
# Set to 1 for multi-tenant auth (requires JWT_SECRET, run database/auth_schema.sql)
# AUTH_ENABLED=0
# JWT_SECRET=your-secret-change-in-production
# FRONTEND_URL=https://your-frontend-url
# CORS_ORIGIN=https://your-frontend-url
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-email-password-or-app-password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true

